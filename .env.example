# ============================================================
# Sultan Grill House Yayinci - ortam degiskenleri
# Bu dosyayi .env olarak kopyala ve gercek degerleri gir.
# Coolify'da bu degerleri "Environment Variables" bolumune yaz.
# ============================================================

# --- Meta / Graph API kimlikleri ---
# Facebook Sayfasi ID (yeni acacagin Sultan Grill House sayfasinin ID'si)
PAGE_ID=

# Instagram Isletme Hesabi ID (npm run get-ids ile ogrenilir; @sultangrillhouse_sultanahmet)
IG_USER_ID=

# KALICI (System User) Sayfa erisim token'i. Runbook'taki adimlarla uretilir.
PAGE_ACCESS_TOKEN=

# Graph API surumu (brief.e gore sabitlenir, orn v25.0)
GRAPH_VERSION=v25.0

# --- GUVENLIK KILIDI (yanlis hesaba yayini onler) ---
# Yukaridaki PAGE_ID ve IG_USER_ID ile AYNI olmali. Farkliysa yayinci hicbir sey gondermez.
LOCK_PAGE_ID=
LOCK_IG_USER_ID=
# Beklenen hesap kullanici adi (dogrulama amacli, bilgi icin)
LOCK_IG_USERNAME=sultangrillhouse_sultanahmet

# --- Gorsel hosting ---
# Yayincinin kendi public adresi. IG/FB gorseli buradan ceker. Sonunda / OLMASIN.
# Coolify domain'i, orn: https://yayin.sultangrillhouse.com
PUBLIC_BASE_URL=

# --- Calisma modu ---
# true iken hicbir gercek paylasim yapilmaz, sadece log'lanir. Canliya gecerken false yap.
DRY_RUN=true
# true iken tum yayin durur (acil fren).
PAUSED=false

# Zaman dilimi
TZ=Europe/Istanbul

# Cron sikligi (dakika). Bos birakma.
TICK_CRON=*/5 * * * *

# Gecikmis paylasimlari yakalama penceresi (dakika). Sunucu bir sure kapali kalirsa
# bu pencere icindeki gecikmis postlari yine de yayinlar; bundan eskisini atlar.
CATCHUP_GRACE_MIN=120

# --- Panel erisimi ---
# Panele ve manuel tetiklemeye erisim anahtari. Uzun ve rastgele bir sey yaz.
ADMIN_KEY=

# Panelin dinleyecegi port
PORT=3000
